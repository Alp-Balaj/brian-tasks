# Copy to .env for `npm run server` locally. On Railway these are service variables.
DATABASE_URL=postgres://user:password@localhost:5432/brian
APP_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
# Presented by Claude (Code, Cowork, chat) and the `brian` CLI at /api/mcp. Long and random:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_TOKEN=change-me-to-a-long-random-string
# "Today" for the MCP tools' dates and Routine Check-ins. The app uses each Device's clock.
TZ=Europe/Amsterdam
